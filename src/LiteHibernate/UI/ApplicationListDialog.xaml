<Window x:Class="LiteHibernate.UI.ApplicationListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скрыть приложение" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources><ResourceDictionary Source="../Themes/Controls.xaml"/></Window.Resources>
  <Border Background="{StaticResource Surface}" BorderBrush="#38465E" BorderThickness="1" CornerRadius="12" Padding="24">
    <StackPanel>
      <TextBlock x:Name="DialogHeading" Text="Скрыть приложение" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="RemovalPrompt" Margin="0,14,0,24" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="13"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelRemovalButton" Content="Отмена" IsCancel="True" IsDefault="True" Margin="0,0,8,0" MinWidth="96"/>
        <Button x:Name="ConfirmRemovalButton" Content="Скрыть" Click="OnConfirm" Foreground="#E9A2AB" Background="#332630" BorderBrush="#62424C" MinWidth="96"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
